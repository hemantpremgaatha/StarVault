{
  "name": "starvault",
  "version": "0.1.0",
  "private": true,
  "description": "StarVault is a platform with an open protocol for personal data ownership, consent, access, and audit.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/website",
    "build": "npm run build -w apps/website",
    "lint": "npm run lint -w apps/website",
    "typecheck": "npm run typecheck -w apps/website",
    "prototype": "node server.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.16.0"
  }
}
